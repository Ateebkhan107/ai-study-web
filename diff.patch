+async function uploadSinglePYQ() {
+  if(!singlePyq.exam || !singlePyq.year || !singlePyq.question){
+    alert("Fill required fields (Exam, Year, Question)");
+    return;
+  }
+  setSinglePyqUploading(true);
+  
+  // Convert attempt date to a nice string if it's a date
+  let attemptStr = singlePyq.attempt;
+  if (attemptStr && attemptStr.includes("-")) {
+    const d = new Date(attemptStr);
+    if (!isNaN(d)) {
+      const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+      attemptStr = `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
+    }
+  }
+
+  const payload = { ...singlePyq, attempt: attemptStr };
+  
+  try {
+    const res = await fetch("/api/admin/single-pyq", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(payload)
+    });
+    
+    const data = await res.json();
+    if(res.ok) {
+      if(data.skipped > 0) alert("Question skipped (duplicate detected) ⚠️");
+      else alert("Question uploaded 🚀");
+      
+      // Reset mostly, keep some context
+      setSinglePyq(prev => ({
+        ...prev, question: "", question_image: "", option_a: "", option_b: "", option_c: "", option_d: "",
+        option_a_image: "", option_b_image: "", option_c_image: "", option_d_image: "",
+        correct_option: "", correct_options: "", numerical_answer: "", numerical_min: "", numerical_max: "",
+        explanation: "", explanation_image: ""
+      }));
+    } else {
+      alert("Failed: " + data.error);
+    }
+  } catch(e) {
+    alert("Something went wrong");
+  }
+  setSinglePyqUploading(false);
+}
